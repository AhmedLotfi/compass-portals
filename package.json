{
  "name": "compass-portal",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "prestart": "node tools/media/build.ts",
    "start": "ng serve",
    "prebuild": "node tools/media/build.ts",
    "build": "ng build",
    "postbuild": "node tools/postbuild/index.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "test:watch": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:probe": "node tools/content-sync/index.ts probe",
    "content:discover": "node tools/content-sync/index.ts discover",
    "test:tools": "vitest run --config tools/vitest.config.ts",
    "typecheck:tools": "tsc -p tools/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint:design": "node tools/verify/design-tells.ts",
    "design:generate": "node tools/design/fonts.ts && node tools/design/spring.ts && node tools/design/contours.ts && node tools/design/icons.ts",
    "content:fetch": "node tools/content-sync/index.ts fetch",
    "content:sync": "node tools/content-sync/index.ts sync",
    "content:all": "node tools/content-sync/index.ts all",
    "media:build": "node tools/media/build.ts",
    "content:fixture": "node tools/content-sync/fixture.ts",
    "start:fixture": "node tools/content-sync/fixture.ts --if-missing && ng serve --configuration=fixture",
    "build:fixture": "node tools/content-sync/fixture.ts --if-missing && ng build --configuration=production,fixture && node tools/postbuild/index.ts --content=.cache/fixture/content",
    "pretest": "node tools/content-sync/fixture.ts --if-missing",
    "verify:hosting": "node tools/verify/hosting.ts",
    "verify:dist": "node tools/verify/dist.ts",
    "e2e": "playwright test",
    "lighthouse": "node tools/verify/lighthouse.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.3.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^24.19.0",
    "@types/sanitize-html": "^2.16.2",
    "angular-eslint": "22.5.0",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "d3-contour": "^4.0.2",
    "domhandler": "^6.0.1",
    "eslint": "^10.9.1",
    "fast-xml-parser": "^5.11.2",
    "html-validate": "^11.16.1",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.5.0",
    "p-limit": "^7.3.3",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.5",
    "simple-icons": "^16.33.0",
    "simplex-noise": "^4.0.3",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
