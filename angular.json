{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "compass-portal": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "source-serif-4-latin*-wght-*.woff2",
                "input": "node_modules/@fontsource-variable/source-serif-4/files",
                "output": "fonts"
              },
              {
                "glob": "hanken-grotesk-latin*-wght-*.woff2",
                "input": "node_modules/@fontsource-variable/hanken-grotesk/files",
                "output": "fonts"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "fixture": {
              "tsConfig": "tsconfig.fixture.json",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "source-serif-4-latin*-wght-*.woff2",
                  "input": "node_modules/@fontsource-variable/source-serif-4/files",
                  "output": "fonts"
                },
                {
                  "glob": "hanken-grotesk-latin*-wght-*.woff2",
                  "input": "node_modules/@fontsource-variable/hanken-grotesk/files",
                  "output": "fonts"
                },
                {
                  "glob": "**/*",
                  "input": ".cache/fixture/public"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "compass-portal:build:production"
            },
            "development": {
              "buildTarget": "compass-portal:build:development"
            },
            "fixture": {
              "buildTarget": "compass-portal:build:development,fixture"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "schema/**/*.ts",
              "tools/**/*.ts",
              "e2e/**/*.ts",
              "playwright.config.ts"
            ]
          }
        }
      }
    }
  }
}
